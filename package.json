{
  "name": "mcj-frontend",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "visual:test": "pnpm --filter @mcj/visual-regression run audit",
    "visual:test:report": "pnpm --filter @mcj/visual-regression run report",
    "visual:discover": "pnpm --filter @mcj/visual-regression run discover",
    "visual:smoke": "pnpm --filter @mcj/visual-regression run smoke"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
